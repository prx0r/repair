# Repair Garden — Environment Variables
# Copy to .env and fill in API keys

# Companies House (free: https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Electricity Maps (free tier: https://electricitymaps.com/)
ELECTRICITY_MAPS_TOKEN=

# Mouser (free for non-commercial: https://www.mouser.com/api/)
MOUSER_API_KEY=

# DigiKey (free for non-commercial: https://developer.digikey.com/)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# eBay (free browse API: https://developer.ebay.com/)
EBAY_APP_ID=

# Nexar (for Octopart data: https://nexar.com/)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Cloudflare R2 (for permanent storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=repair-garden
