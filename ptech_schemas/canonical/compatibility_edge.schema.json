{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compatibility Edge",
  "type": "object",
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "predicate": {
      "enum": [
        "FITS",
        "DOES_NOT_FIT",
        "SUPERSEDES",
        "REPLACEMENT_FOR",
        "USES",
        "CONTAINS",
        "DONOR_FOR"
      ]
    },
    "object_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "evidence_class": {
      "enum": [
        "OFFICIAL",
        "DISTRIBUTOR",
        "OBSERVED",
        "COMMUNITY",
        "INFERRED"
      ]
    }
  },
  "required": [
    "edge_id",
    "subject_id",
    "predicate",
    "object_id",
    "confidence",
    "source_id",
    "source_ref",
    "evidence_class"
  ],
  "additionalProperties": true
}