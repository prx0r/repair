{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTech Asset",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "asset_family": {
      "type": "string"
    },
    "asset_class": {
      "type": "string"
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiers": {
      "type": "object"
    },
    "specifications": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "asset_id",
    "asset_family",
    "asset_class"
  ],
  "additionalProperties": true
}