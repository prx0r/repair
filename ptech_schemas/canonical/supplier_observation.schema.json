    "supplier": {
      "type": "string"
    },
    "part_or_model": {
      "type": "string"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit_price": {
