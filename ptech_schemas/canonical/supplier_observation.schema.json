        "number",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "moq": {
      "type": [
        "number",
        "null"
      ]
    },
    "stock_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "lead_time_days": {
      "type": [
        "number",
        "null"
      ]
    },
    "shipping_quote": {
